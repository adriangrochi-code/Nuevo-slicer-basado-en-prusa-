# HTTPS for the users and the web site (automatic certificate). The nodes of the local network use
# http://<master>:8000.
{$TISMA_DOMAIN} {
    # Largest project accepted (TISMA_MAX_UPLOAD_MB plus the form).
    request_body {
        max_size 210MB
    }
    reverse_proxy api:8000 {
        header_up X-Forwarded-For {remote_host}
    }
}
