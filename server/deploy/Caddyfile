# HTTPS for the users and the web site (automatic certificate), e.g. tismaservidores.net. The administration is only for
# the local network: http://<central>:8000/admin (the master refuses it from other addresses too).
{$TISMA_DOMAIN} {
    # Largest project accepted (TISMA_MAX_UPLOAD_MB plus the form).
    request_body {
        max_size 210MB
    }
    @admin path /admin /admin/* /v1/admin /v1/admin/*
    respond @admin 404
    reverse_proxy api:8000 {
        header_up X-Forwarded-For {remote_host}
    }
}
