# Settings of the master server (copy to .env next to deploy/compose.master.yaml).
POSTGRES_PASSWORD=change-me
# Alerts by e-mail for the administrators (README, "Avisos de problemas"): addresses (empty: the administrator
# accounts), minutes a node may be silent, minutes a job may wait, free disk [GB], hours between reminders.
TISMA_ALERT_EMAILS=
TISMA_ALERT_NODE_MINUTES=5
TISMA_ALERT_QUEUE_MINUTES=30
TISMA_ALERT_DISK_FREE_GB=5
TISMA_ALERT_REPEAT_H=12
# Daily backups of the database (README, "Copias de seguridad"): directory on the host (better another disk), hour
# (UTC) and how many daily and weekly copies are kept.
BACKUP_DIR=./backups
BACKUP_HOUR=3
BACKUP_DAYS=14
BACKUP_WEEKS=8
# Address the users see (Caddy gets its HTTPS certificate for it).
TISMA_DOMAIN=tismaservidores.net
# Key of the web site for /v1/site (long random text: python -c "import secrets; print(secrets.token_urlsafe(32))").
TISMA_SITE_KEY=
# Public IP of the server of the web site (tisma.com.uy): only it may use /v1/site. Empty: any address with the key.
TISMA_SITE_NETWORKS=
# Address of the master on internet: the account page is TISMA_PUBLIC_URL/cuenta (Tisma links to it).
TISMA_PUBLIC_URL=https://tismaservidores.net
# E-mail of the confirmation and new password codes: the SMTP server of the domain (e.g. the mail hosting of
# tisma.com.uy). Empty host: codes only in the log (development; nobody could confirm an account).
TISMA_SMTP_HOST=
TISMA_SMTP_PORT=587
TISMA_SMTP_SECURITY=starttls
TISMA_SMTP_USER=noreply@tisma.com.uy
TISMA_SMTP_PASSWORD=
TISMA_SMTP_FROM=Tisma Cloud <noreply@tisma.com.uy>
# Client IDs of "Sign in with Google" (Google Cloud console > Credentials > OAuth client ID): the web one first, then
# the phone apps, comma separated. Empty: disabled.
TISMA_GOOGLE_CLIENT_IDS=
# Google Play subscriptions of the Android app (see README, "Suscripciones con Google Play"): package name, JSON key of
# the service account invited to the Play Console (keep it out of the repository, readable only by the master), and
# the products of Play with their plan. Empty package: disabled.
TISMA_PLAY_PACKAGE=
TISMA_PLAY_CREDENTIALS=/run/secrets/play-service-account.json
TISMA_PLAY_PRODUCTS=tisma_basico:basico,tisma_pro:pro
# Real-time developer notifications: audience and service account of the Pub/Sub push subscription.
TISMA_PLAY_PUSH_AUDIENCE=https://tismaservidores.net/v1/billing/play/notify
TISMA_PLAY_PUSH_ACCOUNT=
# Payment provider of the account page: empty (payments recorded in the panel) or test (fake, NEVER in production).
TISMA_BILLING_PROVIDER=
# The administration (/admin) only from these networks (default: the private networks of the local network).
# TISMA_ADMIN_NETWORKS=192.168.1.0/24
TISMA_MAX_UPLOAD_MB=200
TISMA_NODE_TIMEOUT_S=90
TISMA_MAX_ATTEMPTS=3
TISMA_CLAIM_WAIT_S=20
TISMA_LARGE_SLICE_TRIANGLES=300000
TISMA_QUEUE_SIZE_WAIT_MAX_S=600
TISMA_MAX_CONNECTIONS=4000
TISMA_RETENTION_H=72
# Privacy: list of jobs kept 90 days, sessions closed after 90 days without use, no log of the requests (1: on).
TISMA_JOB_HISTORY_DAYS=90
TISMA_SESSION_DAYS=90
# Problem reports from Tisma and the app: kept 365 days; per hour from an account and from an address without one.
TISMA_REPORT_DAYS=365
TISMA_REPORTS_PER_HOUR=20
TISMA_ANONYMOUS_REPORTS_PER_HOUR=5
# Translator of the reports on this server (docker compose --profile translate): http://libretranslate:5000; empty: off.
TISMA_TRANSLATE_URL=
TISMA_TRANSLATE_TO=es
# Reward of a useful report (given by hand by an administrator): days of the plan, at most this many per account a year.
TISMA_REPORT_REWARD_DAYS=7
TISMA_REPORT_REWARDS_PER_YEAR=4
TISMA_ACCESS_LOG=0
# Antivirus (ClamAV) for every upload: clamav:3310 with "docker compose --profile antivirus" (needs 3 GiB of memory).
# Empty: without it (projects and G-code are still checked).
TISMA_CLAMD=
# The key of the personal data encrypted in the database (32 bytes in base64). Empty: data.key in the storage folder,
# made on the first start. Keep a copy of it apart from the backups of the database.
TISMA_DATA_KEY=
TISMA_GRACE_DAYS=3
# Internal accounts (the team): unlimited computing, never charged. E-mails and "@domain", comma separated.
TISMA_INTERNAL_EMAILS=
TISMA_LOGIN_PER_MINUTE=10
